{
  "name": "@mantaray0/create-stack",
  "version": "0.2.0",
  "description": "Standalone scaffolder for prototype monorepos — Vite+Hono or Next.js, with shared UI, DB, auth and validation packages.",
  "license": "MIT",
  "author": "mantaray0",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "scaffold",
    "boilerplate",
    "starter",
    "bun",
    "hono",
    "nextjs",
    "drizzle",
    "better-auth",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantaray0/boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/mantaray0/boilerplate/issues"
  },
  "homepage": "https://github.com/mantaray0/boilerplate#readme",
  "bin": {
    "create-stack": "./bin/create-stack.mjs"
  },
  "files": [
    "bin",
    "templates",
    "packages",
    "!packages/*/drizzle",
    "biome.json",
    "tsconfig.base.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    ".",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "bun build tooling/create-stack/src/index.ts --target=node --outfile bin/create-stack.mjs && chmod +x bin/create-stack.mjs",
    "create": "bun tooling/create-stack/src/index.ts",
    "smoke": "bun tooling/create-stack/src/smoke-test.ts",
    "verify": "bun tooling/create-stack/src/verify-templates.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:studio": "bun run --cwd packages/db db:studio",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '@repo/*' typecheck",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
