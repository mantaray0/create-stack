# Local Postgres runs via Docker Compose with exactly these values.
# If port 5432 is already taken, change POSTGRES_PORT (e.g. 5434) and keep
# DATABASE_URL in sync.
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{APP_NAME}}

# Better Auth — the defaults are fine for local prototypes.
# ALWAYS set your own values in production.
BETTER_AUTH_SECRET=dev-secret-change-me
# Origin the browser uses to reach the app (Vite dev server)
BETTER_AUTH_URL=http://localhost:5173
PORT=3001
